PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/jobconnect
JWT_ACCESS_SECRET=replace_with_strong_secret_for_access_token
JWT_REFRESH_SECRET=replace_with_strong_secret_for_refresh_token
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CLIENT_URL=http://localhost:4200

# Optional Cloudinary configuration (falls back to local uploads if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email SMTP Settings (falls back to console log printing if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@jobconnect.com
